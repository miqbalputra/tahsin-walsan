FROM node:24-alpine AS frontend
WORKDIR /src/next/frontend
COPY next/frontend/package.json next/frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY next/frontend/ ./
RUN npm run build:app

FROM golang:1.26-alpine AS backend
WORKDIR /src/next/backend
COPY next/backend/go.mod next/backend/go.sum ./
RUN go mod download
COPY next/backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tahsin-app ./cmd/app \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tahsin-migrate ./cmd/migrate \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tahsin-data-induk-sync ./cmd/data-induk-sync

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 tahsin \
    && adduser -S -D -H -u 10001 -G tahsin tahsin \
    && mkdir -p /app/web /app/web/assets/js /app/web/assets/css /var/lib/tahsin \
    && chown -R 10001:10001 /var/lib/tahsin
COPY --from=backend /out/tahsin-app /usr/local/bin/tahsin-app
COPY --from=backend /out/tahsin-migrate /usr/local/bin/tahsin-migrate
COPY --from=backend /out/tahsin-data-induk-sync /usr/local/bin/tahsin-data-induk-sync
COPY --from=frontend /src/next/frontend/dist/ /app/web/
COPY assets/js/tahsin-autosave.js /app/web/assets/js/tahsin-autosave.js
COPY assets/css/tahsin-autosave.css /app/web/assets/css/tahsin-autosave.css
COPY icon-512.png /app/web/
ENV APP_ENV=production APP_HTTP_ADDR=0.0.0.0:8080 APP_STATIC_DIR=/app/web APP_DATA_DIR=/var/lib/tahsin
WORKDIR /app
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/readyz || exit 1
ENTRYPOINT ["/usr/local/bin/tahsin-app"]
