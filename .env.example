APP_TIMEZONE=Asia/Jakarta
APP_ENV=production
APP_PERF_LOG=0

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_tahsinbpk
DB_USERNAME=tahsinbpk
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5
BACKUP_MAX_UPLOAD_MB=512
# Folder absolut pada volume persisten untuk arsip cadangan (opsional).
# Jika diisi, wajib DI LUAR webroot (mis. /var/tahsin-backups); aplikasi
# menolak folder di webroot karena arsip berisi data pribadi dan hash password.
# Folder ini juga dipakai scripts/backup-database.php (cron backup harian,
# lihat docs/BACKUP_AUTOMATION.md).
BACKUP_STORAGE_PATH=
BACKUP_MAX_EXPANDED_MB=512

SESSION_SAVE_PATH=/var/www/html/.sessions
N8N_API_KEY=ubah_dengan_secret_yang_panjang
HERMES_API_KEY=ubah_dengan_secret_yang_panjang_juga
# Origin (dipisah koma) yang boleh memanggil Hermes API dari browser; kosong = tanpa CORS.
HERMES_ALLOWED_ORIGINS=
# Set 1 hanya bila action schema (struktur database) benar-benar diperlukan.
HERMES_EXPOSE_SCHEMA=

# Secret server-side only. Halaman presensi tidak pernah memanggil URL ini.
DATA_INDUK_ENABLED=false
DATA_INDUK_BASE_URL=https://data.yayasananda.id
DATA_INDUK_API_KEY=mdi_ganti_dengan_api_key_integrasi
DATA_INDUK_UNIT_ID=uuid-unit-kajian-tahsin-bapak
DATA_INDUK_SYNC_STALE_MINUTES=60
APP_VERSION=local

# Autosave aktif setelah migrate_autosave.php --apply. Isi ID untuk pilot terbatas.
TAHSIN_AUTOSAVE_ENABLED=1
TAHSIN_AUTOSAVE_HALAQOH_IDS=
