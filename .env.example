APP_TIMEZONE=Asia/Jakarta
APP_ENV=production
APP_PERF_LOG=0

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_tahsinbpk
DB_USERNAME=tahsinbpk
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5
BACKUP_MAX_UPLOAD_MB=512

SESSION_SAVE_PATH=/var/www/html/.sessions
N8N_API_KEY=ubah_dengan_secret_yang_panjang
HERMES_API_KEY=ubah_dengan_secret_yang_panjang_juga

# Secret server-side only. Halaman presensi tidak pernah memanggil URL ini.
DATA_INDUK_ENABLED=false
DATA_INDUK_BASE_URL=https://data.yayasananda.id
DATA_INDUK_API_KEY=mdi_ganti_dengan_api_key_integrasi
DATA_INDUK_UNIT_ID=uuid-unit-kajian-tahsin-bapak
DATA_INDUK_SYNC_STALE_MINUTES=60
APP_VERSION=local

# Autosave aktif setelah migrate_autosave.php --apply. Isi ID untuk pilot terbatas.
TAHSIN_AUTOSAVE_ENABLED=1
TAHSIN_AUTOSAVE_HALAQOH_IDS=

# Pratinjau Go/Vue: mati secara default, hanya baca data dan khusus admin/PJ.
TAHSIN_NEXT_ENABLED=0
TAHSIN_NEXT_API_URL=http://127.0.0.1:18090
TAHSIN_NEXT_SHARED_SECRET=
# Konfigurasi Go terpisah; tidak memakai DB_* aplikasi PHP.
TAHSIN_NEXT_LISTEN=127.0.0.1:18090
TAHSIN_NEXT_DATA_SOURCE=demo
TAHSIN_NEXT_DB_HOST=127.0.0.1
TAHSIN_NEXT_DB_PORT=3306
TAHSIN_NEXT_DB_DATABASE=
TAHSIN_NEXT_DB_USERNAME=
TAHSIN_NEXT_DB_PASSWORD=
TAHSIN_NEXT_DB_TLS=false

# Pilot tampilan guru Vue dengan API PHP yang sama; wajib daftar kelompok eksplisit.
TAHSIN_VUE_TEACHER_ENABLED=0
TAHSIN_VUE_TEACHER_HALAQOH_IDS=

# Baca sesi Go untuk perbandingan staging; editor dan penyimpanan tetap PHP.
# Wajib mode mysql, akun SELECT-only, skema lengkap dan daftar kelompok eksplisit.
TAHSIN_NEXT_TEACHER_READ_ENABLED=0
TAHSIN_NEXT_TEACHER_READ_HALAQOH_IDS=
