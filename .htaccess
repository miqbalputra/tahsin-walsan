# Security Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS: Paksa browser selalu gunakan HTTPS (berlaku 1 tahun)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Disable Directory Listing
Options -Indexes

# Set Directory Index
DirectoryIndex index.php login.php

# Private source files and local exports never belong in an HTTP response.
# JSON diblokir kecuali manifest.json (dibutuhkan PWA); CSV diblokir kecuali
# template_*.csv (template impor publik yang tidak berisi data nyata).
<FilesMatch "(?i)(^\.(?!well-known$)|\.(sql|sqlite3?|db|zip|gz|bak|ini|log|phar|md|xlsx|toml|ya?ml|lock)$|^(?!manifest\.json$)[^/]*\.json$|^(?!template_)[^/]*\.csv$|^(Dockerfile|phpunit\.xml|tailwind\.config\.js)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,END]
    RewriteRule ^(config|includes|templates|tests|scripts|docker|migrations|docs|temp_excel|backup|outputs|node_modules|vendor|next)(/|$) - [F,END,NC]
</IfModule>

# One-off migration scripts are CLI-only in production. This prevents an
# accidental or unauthenticated browser request from changing the schema.
<FilesMatch "^(migrate.*|dev-router)\.php$">
    Require all denied
</FilesMatch>

<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </IfModule>
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
</Files>
