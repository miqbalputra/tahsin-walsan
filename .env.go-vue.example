# Salin ke env resource Go+Vue setelah backup dan clone uji siap.
# DB_HOST tetap memakai hostname internal resource MySQL Coolify yang sekarang.
APP_ENV=production
APP_PRODUCTION_READY=0
APP_EXPECTED_DB_DATABASE=db_tahsinbapak
APP_HTTP_ADDR=0.0.0.0:8080
APP_STATIC_DIR=/app/web
APP_DATA_DIR=/var/lib/tahsin
APP_TIMEZONE=Asia/Jakarta
AUTH_COOKIE_NAME=tahsin_session
AUTH_SESSION_DAYS=30

DB_HOST=mysql-internal-coolify
DB_PORT=3306
DB_DATABASE=db_tahsinbapak
DB_USERNAME=tahsin_go_app
DB_PASSWORD=SET_DI_COOLIFY_SECRET
DB_CHARSET=utf8mb4
# Opsional: path CA bila resource MySQL mewajibkan TLS terverifikasi.
DB_TLS_CA_FILE=

# Gunakan nilai integrasi yang sama dengan aplikasi lama.
HERMES_API_KEY=KEEP_EXISTING_COOLIFY_SECRET
N8N_API_KEY=KEEP_EXISTING_COOLIFY_SECRET
DATA_INDUK_ENABLED=false
DATA_INDUK_BASE_URL=https://data.yayasananda.id
DATA_INDUK_API_KEY=KEEP_EXISTING_COOLIFY_SECRET
DATA_INDUK_UNIT_ID=uuid-unit-kajian-tahsin-bapak
DATA_INDUK_SYNC_STALE_MINUTES=60
BACKUP_MAX_UPLOAD_MB=512
APP_VERSION=go-vue

# MIGRATION_DB_USERNAME dan MIGRATION_DB_PASSWORD hanya dipakai sementara
# untuk perintah tahsin-migrate; jangan masukkan ke environment runtime app.
